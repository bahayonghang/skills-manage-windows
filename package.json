{
  "name": "skillport",
  "private": true,
  "version": "1.0.2",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.12.3",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/build/dev-server.mjs",
    "build": "tsc && vite build",
    "build:cli": "cargo build --manifest-path src-tauri/Cargo.toml --release --bin skillport-cli --locked",
    "cli": "cargo run --manifest-path src-tauri/Cargo.toml --bin skillport-cli --",
    "entrypointcheck": "node scripts/check/check-rust-entrypoints.mjs",
    "install:cli": "cargo install --path src-tauri --bin skillport-cli --locked --force",
    "ipc:codegen": "cargo run --manifest-path src-tauri/Cargo.toml --features ipc-codegen --bin skillport --locked -- --ipc-codegen",
    "ipc:codegen:check": "cargo run --manifest-path src-tauri/Cargo.toml --features ipc-codegen --bin skillport --locked -- --ipc-codegen --check",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:serial": "node scripts/check/run-vitest-sequential.mjs",
    "test:watch": "vitest",
    "version:check": "node scripts/check/sync-version.mjs --check",
    "sizecheck": "node scripts/check/check-size-budget.mjs",
    "capabilitycheck": "node scripts/check/check-capability-drift.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --cache --cache-location node_modules/.cache/eslint/ --report-unused-disable-directives --max-warnings 0",
    "audit:dependencies": "node scripts/check/check-dependency-audit.mjs",
    "doctor": "node scripts/check/doctor.mjs",
    "release:preflight": "node scripts/release/release-preflight.mjs",
    "docs:gen": "node scripts/docs/build-ipc-dict.mjs && node scripts/docs/build-schema-table.mjs",
    "docs:gen:check": "node scripts/docs/build-ipc-dict.mjs --check && node scripts/docs/build-schema-table.mjs --check",
    "docs:dev": "pnpm docs:gen && vitepress dev docs",
    "docs:site:build": "vitepress build docs",
    "docs:build": "pnpm docs:gen:check && pnpm docs:site:build",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/instrument-serif": "5.2.8",
    "@lobehub/icons": "^5.15.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^29.1.1",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.14",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.7",
    "yaml": "^2.9.0"
  }
}
